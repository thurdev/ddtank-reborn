# All optional. Defaults point to local dev (http://localhost:8080).
DDT_API_URL=http://localhost:8080
# DDT_MANIFEST_URL=http://localhost:8080/api/public/launcher
# DDT_LOGIN_URL=http://localhost:8080/api/auth/login
# DDT_UPDATE_URL=http://localhost:8080/launcher/updates/
# DDT_SWF_URL=http://localhost:8080/flash/Loading.swf
# DDT_CONFIG_XML_URL=http://localhost:8080/flash/config.xml
# Local runtime paths (skip download in dev):
# DDT_PROJECTOR_PATH=C:\Tools\flashplayer_32_sa.exe
# DDT_RUFFLE_PATH=C:\Tools\ruffle\ruffle.exe
# Used by scripts/fetch-runtime.mjs (bundling a runtime into the installer):
# DDT_PROJECTOR_URL=https://your-mirror/flashplayer_32_sa.exe
# DDT_PROJECTOR_SHA256=<64 hex>
# DDT_RUFFLE_URL=https://github.com/ruffle-rs/ruffle/releases/download/nightly-.../ruffle-nightly-...-windows-x86_64.zip
# DDT_RUFFLE_SHA256=<64 hex>
