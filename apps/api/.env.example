# apps/api — copy to .env (values shown are the defaults)
PORT=8080
PUBLIC_URL=http://localhost:8080          # base for REQUEST_PATH/FLASHSITE/SITE in config.xml and the play config
SITE_URL=http://localhost:5173            # apps/web (LOGIN_PATH, REGISTER in config.xml)
USER_GUIDE_ENABLE=false                   # config.xml USER_GUILD_ENABLE (4.1 newbie guide; needs trainer assets)
# DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/db?sslmode=require   # unset = PGlite (packages/db/.data/pglite)
DB_MIGRATE=true
DB_SEED_IF_EMPTY=true
JWT_SECRET=                               # REQUIRED in production
JWT_TTL=604800
LOGIN_KEY_TTL_MIN=30                      # one-time flashvar key lifetime (Web.config LoginSessionTimeOut)
GAME_KEY_TTL_MIN=1440                     # socket password (tempPwd) lifetime after Login.ashx
LOGIN_KEY=                                # legacy CreateLogin.aspx md5 secret; empty disables that endpoint
# RSA key matching the modulus in the client's 2.png (.NET <RSAKeyValue> XML or PEM). Generate: pnpm --filter @ddt/api gen-rsa-key
RSA_PRIVATE_KEY=
RSA_PRIVATE_KEY_FILE=
RSA_USE_VENDOR_KEY=true                   # dev only: use the public pair from vendor Tank.Request/Web.config (unpatched client)
# ch-tabela/ch-processo (vários canais): id da linha de player."Server_List" que é o canal "local" deste par
# apps/api+apps/game — tem que bater com o SERVER_ID do apps/game (apps/game/.env.example). ServerList.ashx usa
# pra decidir de qual canal mostrar o Online em tempo real via GAME_INTERNAL_URL (em vez do valor gravado na
# linha); os outros canais (rodando noutro par apps/api+apps/game, ch-processo) mostram o Online em tempo real
# via o InternalUrl da PRÓPRIA linha (cacheado ~5s, fetchRemoteStatus em routes/public.ts), com fallback pro
# Online gravado na linha se esse outro processo não responder ou a linha não tiver InternalUrl ainda.
SERVER_ID=4
GAME_HOST=127.0.0.1                       # fallback IP quando o canal local (Server_List.IP) não tem um próprio; o que ServerList.ashx advertises (= Ruffle socketProxy host)
GAME_PORT=9200                            # fallback porta real quando o canal local (Server_List.Port) não tem uma própria (ServerList sends GAME_PORT-69)
GAME_WS_URL=ws://localhost:9300/ws        # apps/game WebSocket for Ruffle (canal local); outros canais usam o WsUrl da própria linha (ch-processo) nos socketProxy do Ruffle
POLICY_PORT=843
GAME_INTERNAL_URL=http://127.0.0.1:9400   # apps/game internal HTTP (/status, /stats) do canal local (SERVER_ID acima)
FLASH_DIR=../../vendor/DDTank41/Source Flash/FlashSV1
RESOURCE_DIR=../../vendor/_assets/merged
RUFFLE_DIR=../client-harness/public/ruffle
# Cliente PixiJS (sem Flash). Definido = a página Jogar usa ele no lugar do Ruffle.
# Em dev (NODE_ENV=development) o padrão já é http://localhost:5180/; PIXI_CLIENT_URL=off volta pro Ruffle.
PIXI_CLIENT_URL=
SERVER_NAME=DDTank Reborn
CORS_ORIGINS=*
STORAGE=local                             # local | s3 (R2/S3/MinIO)
UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
CELEB_REBUILD_MIN=10

# apps/game ADMIN_TOKEN, if set there (internal channel: reload-templates, events, mail-notice)
GAME_INTERNAL_TOKEN=

# Admin item editor "Gerar ícone (IA)" button (apps/api/src/lib/icon-style.ts). Key loaded from this env var OR
# the gitignored .env.recraft at the repo root (same lookup as tools/i18n/ai/rc.mjs) — never commit the real key.
RECRAFT_API_KEY=

# --- Pix (doação voluntária, nunca vantagem de jogo) — docs/features/doacao-pix.md ---
PIX_PROVIDER=fake                         # fake (dev/teste, default) | static (Pix estático, sem PSP) | mercadopago
PIX_CHARGE_TTL_MIN=30                     # minutos até uma cobrança expirar
PIX_MIN_AMOUNT=5                          # reais (não centavos)
PIX_MAX_AMOUNT=5000
# PIX_PROVIDER=static: chave Pix do recebedor (e-mail, telefone +55DDDNUMERO, CPF/CNPJ ou chave aleatória)
PIX_STATIC_KEY=
PIX_MERCHANT_NAME=DDTANK REBORN
PIX_MERCHANT_CITY=BRASIL
# PIX_PROVIDER=fake: segredo do webhook de teste (header x-fake-signature) — nunca usado em produção
PIX_FAKE_WEBHOOK_SECRET=fake-webhook-secret
# PIX_PROVIDER=mercadopago: painel Mercado Pago > Suas integrações > Credenciais (Access Token de produção)
PIX_MP_ACCESS_TOKEN=
# PIX_PROVIDER=mercadopago: mesma tela, aba "Webhooks" > Secret key (valida a assinatura de /api/pix/webhook)
PIX_MP_WEBHOOK_SECRET=
# PIX_PROVIDER=mercadopago: e-mail exigido pela API de pagamentos; não coletamos e-mail do doador
PIX_MP_PAYER_EMAIL=doacao@ddtank.local
