# apps/game — copy to .env (never commit secrets). All keys: src/config.ts.
NODE_ENV=development
LOG_LEVEL=info
# Unset -> embedded PGlite at packages/db/.data/pglite (one process only; run `pnpm --filter @ddt/db db:serve`
# and use the postgres URL below when apps/api runs at the same time).
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Neon: DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ch-tabela/ch-processo (vários canais): id da linha de player."Server_List" que este processo serve ("Canal
# N") — Room/Total/ZoneId/ZoneName vêm dela, e Online é gravado nela a cada heartbeat (db/templates.ts). O seed
# tem só o ID 4 "Reborn" (canal único, comportamento de hoje); um 2º canal é outro processo apps/game com
# SERVER_ID apontando pra outra linha (criada no admin, página "Canais") e porta própria — gerado
# automaticamente em produção por `scripts/channels-compose.mjs` (ver docs/GAME-SERVER.md "Canais") ou subido
# localmente com `pnpm dev:all CHANNELS=5,6` (scripts/dev.mjs). Também grava `OnlineServerID` em
# player."Sys_Users_Detail" no login (db/characters.ts setOnlineState) pra `resetAllOnline` no boot nunca zerar
# o "online" de jogadores logados em OUTRO canal/processo no mesmo Postgres.
# Precisa bater com o SERVER_ID do apps/api que serve este mesmo canal (apps/api/.env.example).
SERVER_ID=4

# ch-bus (barramento entre canais, docs/GAME-SERVER.md "Canais"): redis://host:6379[/db]. Vazio (padrão) =
# NoopBus — canal único se comporta exatamente como antes desta tarefa (login/chat mundial/sussurro/presença
# nunca saem deste processo). Setado -> coordena com qualquer OUTRO apps/game que aponte pro MESMO Redis:
# login único entre canais (derruba sessão velha em outro canal), chat mundial/sussurro entre canais,
# presença de amigo/sociedade online em tempo real entre canais. `docker-compose.yml` tem um serviço `redis`
# (opcional) pra produção; local: `docker run --rm -p 6379:6379 redis:7-alpine` ou qualquer Redis já instalado.
# REDIS_URL=redis://127.0.0.1:6379

PUBLIC_HOST=127.0.0.1
BIND_HOST=0.0.0.0
# Real TCP port. apps/api ServerList.ashx advertises GAME_PORT-69 (the client adds 69) -> keep both GAME_PORT equal.
GAME_PORT=9200
WS_ENABLED=true
WS_PORT=9300
WS_PATH=/ws
# Comma list, or * for any (dev). Ruffle page origin(s) in production.
WS_ALLOWED_ORIGINS=*
WS_MAX_PAYLOAD=65536
# WS_PUBLIC_URL=wss://game.example.com/ws
POLICY_ENABLED=true
POLICY_PORT=843

# RSA private key matching the modulus compiled into the client (2.png). Same sources as apps/api:
# RSA_PRIVATE_KEY=<RSAKeyValue>...</RSAKeyValue>   (or PEM)
# RSA_PRIVATE_KEY_FILE=./secrets/login-key.xml
# Dev only: use the PUBLIC pair from vendor/DDTank41/Tank.Request/Web.config.
RSA_USE_VENDOR_KEY=true

ADMIN_ENABLED=true
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9400
# ADMIN_TOKEN=change-me

SAVE_INTERVAL_MIN=10
PING_INTERVAL_MIN=3
SPEED_CHECK_ENABLED=true
SPEED_CHECK_INTERVAL_MIN=5
SPEED_CHECK_TOLERANCE_SEC=15
SPEED_CHECK_BAN_MIN=20
SPEED_CHECK_MISSING_MIN=90
SPEED_CHECK_MISSING_BAN_MIN=60

RATE_EXP=1
RATE_GOLD=1
RATE_OFFER=1
RATE_DROP=1

MAX_ROOMS=200
MAX_CONNECTIONS=8000
MAX_CONNECTIONS_PER_IP=20
PACKET_RATE_PER_SEC=60
PACKET_RATE_BURST=200
LOGIN_TIMEOUT_SEC=60
CHAT_COOLDOWN_SEC=3
BOT_FALLBACK_SEC=25          # lone Match room -> bots (app."Bots") after N s; 0 = off
# LANGUAGE_FILE=./data/Language-vn.txt
# Dev only: accept any socket LOGIN password (refused in production).
DEV_ALLOW_ANY_TICKET=false
SERVER_HEARTBEAT=true

# Events: scheduler poll (s, 0 = off) and free first-recharge gift (no real payments)
EVENT_TICK_SEC=30
FIRST_RECHARGE_FREE=true
# QA only, refused when NODE_ENV=production (config.ts loadConfig):
# EVENTS_ALL_OPEN=true -> every hall activity icon is sent on login regardless of its scheduler window
#   (session/login.ts sendActivityIcons). ALL_OPEN=true does that AND also: bypasses chickenbox/luckystar/
#   labyrinth admin "enabled:false" (handlers/eventos/agendador.ts isOpen), forces world boss + league +
#   elite windows open at startup/reload (handlers/eventos/agendador.ts EventsRuntime.reload), and lets any
#   player level enter any Dungeon room (rooms/room-mgr.ts enterRoom LevelLimits check). Every gate stays
#   `cfg.ALL_OPEN || <original rule>` -- turn it back off (unset or =false) to restore stock behavior.
# EVENTS_ALL_OPEN=false
# ALL_OPEN=false
