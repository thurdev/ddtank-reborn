# apps/client — copy to .env (read at `vite build` time only; dev server ignores this, see vite.config.ts)

# Base URL for the exported assets (PNG + library.json + MP3, apps/client/public/assets — see
# docs/client-pixi/ASSETS.md) that a PRODUCTION build should load from, instead of this app's own
# /assets/ (which a production build no longer ships — vite.config.ts build.copyPublicDir:false, see
# docs/client-pixi/STATUS.md). Must end with "/". Get this value by running scripts/assets-r2-sync.mjs
# (docs/deploy/README.md "assets no CDN") — it prints the public base URL to put here after a sync.
#
# Leave blank for a local build/preview with no CDN configured yet: the client then looks for assets at
# its own origin (`/assets/`), which only works if something else is serving them there (the Vite DEV
# server does this automatically from public/assets; a `vite build` output does not).
VITE_ASSETS_BASE_URL=
