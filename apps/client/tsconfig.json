{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "useDefineForClassFields": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitOverride": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
