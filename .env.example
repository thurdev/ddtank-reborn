# Compose-level config. Copy to .env (never commit the real one) — docker-compose.yml and
# docker/caddy/Caddyfile read these. Per-app secrets live in apps/api/.env and apps/game/.env
# (generate both with: node scripts/gen-secrets.mjs).

# --- Postgres (postgres:17 container) ---
POSTGRES_USER=ddtank
POSTGRES_PASSWORD=                      # set by scripts/gen-secrets.mjs
POSTGRES_DB=ddtank

# --- Caddy ---
# Domain deploy: SITE_ADDRESS=example.com, ADMIN_ADDRESS=admin.example.com -> automatic HTTPS (Let's Encrypt).
#   DNS: point both A/AAAA records at this VM's public IP. ACME_EMAIL is required by Let's Encrypt.
# IP-only / no-domain deploy (leave blank): defaults to plain HTTP on :80 (site) and :8081 (admin).
SITE_ADDRESS=
ADMIN_ADDRESS=
ACME_EMAIL=

# --- Image tag (used by scripts/deploy/update.sh; irrelevant for local `docker compose build`) ---
IMAGE_TAG=latest

# --- Client art on a CDN (scripts/assets-r2-sync.mjs, docs/deploy/README.md "assets no CDN") ---
# Cloudflare R2 (S3-compatible). Only used by that script when run WITHOUT --dry-run/--target — never
# read by docker-compose.yml or any running service. Dashboard > R2 > Manage API Tokens > create a token
# scoped to one bucket; R2_ACCOUNT_ID is in the R2 dashboard URL / Overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=                           # override; default https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Public base URL the bucket is served from (R2 public bucket URL, or a custom domain mapped to it in
# the Cloudflare dashboard) — printed back by the sync script; copy it into apps/client/.env as
# VITE_ASSETS_BASE_URL (with a trailing slash) before building the client for production.
R2_PUBLIC_URL=

# --- Built client (apps/client), served by Caddy alongside web/admin (docker/caddy/) ---
# Same domain/port pattern as SITE_ADDRESS/ADMIN_ADDRESS above. CLIENT_ADDRESS examples:
#   client.example.com   -> automatic HTTPS (needs DNS pointed here)
#   :8082                 -> plain HTTP, IP-only deploy (default if left blank)
# Whatever this resolves to (with the right scheme) is what apps/api/.env's PIXI_CLIENT_URL must point
# at — apps/web's Play page embeds that URL in an iframe (apps/web/src/components/GameFrame.tsx).
CLIENT_ADDRESS=
# Baked into the client bundle at `docker compose build` time (docker/caddy/Dockerfile client-build
# stage) — see apps/client/.env.example. Leave blank only for a build with no real art (testing).
VITE_ASSETS_BASE_URL=
