{
  "name": "ddtank-reborn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter \"!@ddt/client\" -r typecheck",
    "typecheck:client": "pnpm --filter @ddt/client typecheck",
    "test": "pnpm -r test",
    "dev:all": "node scripts/dev.mjs",
    "free-ports": "bash scripts/free-ports.sh",
    "channels:compose": "tsx scripts/channels-compose.mjs",
    "assets:sync:dry": "node scripts/assets-r2-sync.mjs --dry-run",
    "assets:sync": "node scripts/assets-r2-sync.mjs",
    "client:art": "node tools/i18n/build-client-art.mjs",
    "lang:6600": "node tools/i18n/lang-6600.mjs",
    "swftext:6600": "node tools/i18n/build-client-art.mjs --only-swf-text-6600"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ddt/db": "workspace:*",
    "drizzle-orm": "^0.45.3"
  }
}
