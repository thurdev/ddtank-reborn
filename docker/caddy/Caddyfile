{
	# empty email -> Caddy skips ACME account registration until SITE_ADDRESS is a real domain.
	email {$ACME_EMAIL:""}
}

# Main site: player website (apps/web) + API/game reverse proxy.
# SITE_ADDRESS examples:
#   example.com          -> Caddy gets a Let's Encrypt cert automatically (needs DNS pointed here, port 80+443 open)
#   :80                   -> plain HTTP, for an IP-only / no-domain deploy (default)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@ws path /ws*
	reverse_proxy @ws game:9300

	@api path /api* /request* /flash* /resource* /uploads*
	reverse_proxy @api api:8080

	root * /srv/web
	try_files {path} /index.html
	file_server
}

# Admin panel (apps/admin), on its own hostname or port so it is never served from the player domain.
# ADMIN_ADDRESS examples: admin.example.com (auto HTTPS) | :8081 (plain HTTP, IP-only deploy)
{$ADMIN_ADDRESS::8081} {
	encode zstd gzip

	@api path /api*
	reverse_proxy @api api:8080

	root * /srv/admin
	try_files {path} /index.html
	file_server
}

# PixiJS game client (apps/client), on its own hostname or port — apps/api/.env's PIXI_CLIENT_URL must
# point here (apps/web's Play page embeds it in an iframe, GameFrame.tsx). Its own block (not folded
# into the main site like /resource* etc. above) because it needs NO "/api* -> api:8080" proxy of its
# own: the client talks to the API via the `api` flashvar the iframe URL already carries (an absolute
# URL to wherever apps/api is reachable — same SITE_ADDRESS host, different path — so it works from a
# different origin without CORS trouble on static files). CLIENT_ADDRESS examples: client.example.com
# (auto HTTPS) | :8082 (plain HTTP, IP-only deploy). Does NOT serve /assets/* — the exported art (several
# GB) ships on a CDN instead (VITE_ASSETS_BASE_URL baked in at build time, scripts/assets-r2-sync.mjs,
# docs/deploy/README.md "assets no CDN"), never through this container.
{$CLIENT_ADDRESS::8082} {
	encode zstd gzip

	root * /srv/client
	try_files {path} /index.html
	file_server
}
